# Sahayak AI Backend Environment Configuration (Milestone 1)
ENVIRONMENT=development
PORT=8000
DATABASE_URL=sqlite:///./sahayak.db
SYNC_DATABASE_URL=sqlite:///./sahayak.db
# Local-only origins above. Production must use exact HTTPS client origins.
ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006,http://127.0.0.1:19006,http://localhost:5173,http://127.0.0.1:5173

# Leave blank for a process-local random development key; set a private random
# value for deployments. Never commit the actual .env file.
JWT_SECRET=

# Stripe Payment Provider Configuration (Milestone S0)
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_LIVE_ENABLED=false
# Keep false unless Stripe has explicitly approved this exact wallet/lending use case in writing.
STRIPE_FINANCIAL_SERVICES_APPROVED=false
STRIPE_RETURN_URL=ubankuapp://payment-return

# For Vercel production, configure a pooled PostgreSQL DATABASE_URL, a stable
# JWT_SECRET, and HTTPS ALLOWED_ORIGINS in Vercel Project Settings.

# AI providers — disabled until enabled and consented to in the client
AI_EXTERNAL_PROCESSING_ENABLED=false
AI_REAL_USER_ROLLOUT_APPROVED=false
AI_PAYMENT_CONTEXT_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=5
OPENROUTER_DAILY_LIMIT=40
OPENROUTER_MINUTE_LIMIT=15
AI_USER_HOURLY_LIMIT=30
# Set a stable, random secret for keyed anonymous/user quota identifiers in deployed environments.
AI_RATE_LIMIT_HMAC_KEY=
SARVAM_API_KEY=
SARVAM_TIMEOUT_SECONDS=8
SARVAM_TTS_VOICE_EN=simran_en_conversation
SARVAM_TTS_VOICE_HI=roopa_hi_conversational
SARVAM_TTS_VOICE_MR=ishita_mr_conversational
SARVAM_TTS_VOICE_HINGLISH=ishita_enhi_companion
SARVAM_TTS_PACE=1.0
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Optional External Services
FIREBASE_CREDENTIALS_PATH=
FIREBASE_PROJECT_ID=sahayakai-demo

# Supabase (Optional external database/auth)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional password-reset email delivery
SENDER_ADDRESS=
SMTP_ACCOUNT_USERNAME=
SMTP_ACCOUNT_PASSWORD=
